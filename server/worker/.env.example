# Local-only secrets for `wrangler dev` and `npm test`. Copy to .env (gitignored).
# In production these are Worker secrets (`npx wrangler secret put <NAME>`) and are
# NOT stored here. Non-secret config lives in wrangler.toml [vars].

# OpenRouter key. Give it its own credit cap — that cap, not the rate limiter, is
# the hard spending boundary.
OPENROUTER_API_KEY=sk-or-...

# Gates POST /v1/register. Must match the value compiled into the app and widget
# via --dart-define=PAL_PROVISIONING_KEY=... (see dart_defines/prod.json).
PAL_PROVISIONING_KEY=change-me-long-random
