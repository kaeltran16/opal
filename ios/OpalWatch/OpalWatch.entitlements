<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- HealthKit for the workout session the phone starts: heart rate, energy and
     distance while it runs, and the workout saved to Health when it ends. -->
<dict>
	<key>com.apple.developer.healthkit</key>
	<true/>
</dict>
</plist>
